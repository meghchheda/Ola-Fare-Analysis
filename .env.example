# Copy to .env in the project root. No secrets are needed; everything here is configuration.

# Path to the bookings CSV (relative to the project root, or absolute)
DATASET_PATH=data/Bookings-100000-Rows.csv

# Where trained models, metrics and result tables are written / read
MODEL_ARTIFACT_DIR=artifacts

# Published Power BI report link ("Publish to web" or shared report URL). Leave blank until you have one.
POWER_BI_URL=

# Final project report: either an online link ...
REPORT_URL=
# ... and/or a file on the server (PDF or DOCX), e.g. docs/OLA_Ride_Insights_Report.pdf
REPORT_FILE_PATH=

# Origins allowed to call the API from a browser (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend only (set in frontend/.env). Leave unset in development: Vite proxies /api to the backend.
# VITE_API_BASE_URL=https://your-api-host.example.com
# API_PROXY_TARGET=http://127.0.0.1:8000
